
{
  "manifest_version": 3,
  "name": "AI Web Filter",
  "version": "1.0.0",
  "description": "AI-powered web content filter for blocking NSFW, violent, and suicidal content in real-time",
  "permissions": [
    "storage",
    "webNavigation", 
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "generated-icon.png",
      "48": "generated-icon.png",
      "128": "generated-icon.png"
    }
  },
  "icons": {
    "16": "generated-icon.png",
    "48": "generated-icon.png",
    "128": "generated-icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/block.html",
        "pages/block.css",
        "models/*",
        "utils/*",
        "filters/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "incognito": "spanning"
}
